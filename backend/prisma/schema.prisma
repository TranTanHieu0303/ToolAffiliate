datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemConfig {
  id                    String   @id @default("default")
  telegramBotToken      String?
  telegramChatId        String?
  geminiApiKey          String?
  shopeeAppKey          String?
  shopeeAppSecret       String?
  lazadaAppKey          String?
  lazadaAppSecret       String?
  searchIntervalMinutes Int      @default(60)
  isScannerActive       Boolean  @default(false)
  scrapeMethod          String   @default("api") // "api" | "browser"
  shopeeCookie          String?  @db.Text
  lazadaCookie          String?  @db.Text
  promptTemplate        String?  @db.Text
  isAutoSendTelegram    Boolean  @default(true)
  shopeeAffiliateId     String?
  lazadaAffiliateId     String?
  accessTradeId         String?
  lazadaSearchMethod    String   @default("catalog")
  adsenseLinkConvert    Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model SearchKeyword {
  id        String   @id @default(uuid())
  keyword   String   @unique
  maxPrice  Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id             String   @id @default(uuid())
  platform       String   // "SHOPEE" | "LAZADA"
  productId      String
  title          String
  imageUrl       String?
  originalPrice  Float
  discountPrice  Float
  discountMargin Float?   // Phần trăm giảm giá
  voucherCode    String?
  originalUrl    String   @db.Text
  affiliateUrl   String?  @db.Text
  rawInfo        String?  @db.Text
  aiCaption      String?  @db.Text
  status         String   @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  canUseCoins    Boolean  @default(false)
  maxCoinsRedeem Int      @default(0)
  shopVoucher    Float    @default(0)
  platformVoucher Float   @default(0)
  priceAfterCoins Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sentAt         DateTime?

  @@unique([platform, productId])
}

model Order {
  id             String   @id @default(uuid())
  platform       String   // "SHOPEE" | "LAZADA"
  orderId        String   @unique
  productName    String
  orderValue     Float
  commission     Float
  status         String   @default("PENDING") // "PENDING" | "COMPLETED" | "CANCELLED"
  purchaseDate   DateTime
  createdAt      DateTime @default(now())
}