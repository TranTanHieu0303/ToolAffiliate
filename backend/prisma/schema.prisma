datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemConfig {
  id                 String   @id @default("default")
  telegramBotToken   String?
  telegramChatId     String?
  geminiApiKey       String?
  shopeeVietnamAppId String?
  shopeeVietnamAppSecret String?
  lazadaAppKey       String?
  lazadaAppSecret    String?
  searchIntervalMinutes Int @default(60)
  isScannerActive    Boolean @default(true)
  isAutoSendTelegram Boolean @default(true)
  shopeeAffiliateId  String?
  lazadaAffiliateId   String?
  accessTradeId       String?
  shopeeCookie       String?
  lazadaCookie        String?
  scrapeMethod        String   @default("api") // "api" | "browser"
  adsenseLinkConvert  Boolean  @default(false)  // Convert Lazada links via Adsense portal
  promptTemplate     String
  updatedAt          DateTime @updatedAt
}

model SearchKeyword {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique
  maxPrice  Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Deal {
  id              String    @id @default(uuid())
  platform        String    // "SHOPEE" | "LAZADA"
  productId       String
  title           String
  imageUrl        String?
  originalPrice   Float
  discountPrice   Float
  discountPercent Float
  originalUrl     String
  affiliateUrl    String
  rawInfo         String?
  aiCaption       String?
  status          String    @default("PENDING") // PENDING, SENT, FAILED
  canUseCoins     Boolean   @default(false)
  maxCoinsRedeem  Int       @default(0)
  shopVoucher     Float     @default(0)
  platformVoucher Float     @default(0)
  priceAfterCoins Float?
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
}

model Order {
  id           String   @id
  platform     String   // "SHOPEE" | "LAZADA"
  purchaseTime DateTime
  orderValue   Float
  commission   Float
  status       String   // "PENDING" | "COMPLETED" | "CANCELLED"
  productName  String
  createdAt    DateTime @default(now())
}
